# Copy this file to .env and fill in your Twitch application details.
TWITCH_CLIENT_ID=put_your_client_id_here
TWITCH_CLIENT_SECRET=put_your_client_secret_here
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3000

# Leave these alone for real Twitch. The alternate values let the Twitch CLI
# send mock EventSub messages to your app later.
EVENTSUB_WEBSOCKET_URL=wss://eventsub.wss.twitch.tv/ws
EVENTSUB_SUBSCRIPTIONS_URL=https://api.twitch.tv/helix/eventsub/subscriptions

# Optional: when using Twitch CLI's local mock server, mock cheers have no
# viewer message. Set this to 1, 2, 3, or 4 to choose their test segment.
MOCK_DEFAULT_SEGMENT=1
